<odoo>
  <record id="action_my_skills" model="ir.actions.act_window">
        <field name="name">My Skills</field>
        <field name="res_model">hr.employee.skill</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('employee_id.user_id','=',uid)]</field>
        <field name="context">{"search_default_group_by_skill_type":1}</field>
    </record>

    <record id="action_all_skills" model="ir.actions.act_window">
        <field name="name">All Skills</field>
        <field name="res_model">hr.employee.skill</field>
        <field name="view_mode">pivot,tree,form</field>
        <field name="context">{}</field>
<!--        "search_default_group_by_skill":1-->
<!--        <field name="views">[("view_hr_employee_skill_tree", "tree")]</field>-->
    </record>

    <menuitem
        id="menu_skills_view"
        name="Skills"
        groups="base.group_user,hr.group_hr_user,hr.group_hr_manager"
        parent="hr.menu_hr_root"
    />
    <menuitem
        id="menu_skills_view_my_skills"
        name="My Skills"
        groups="base.group_user,hr.group_hr_user,hr.group_hr_manager"
        parent="hr_skills_management.menu_skills_view"
        action="action_my_skills"
    />
    <menuitem
        id="menu_skills_view_all_skills"
        name="All Skills"
        groups="base.group_user,hr.group_hr_user,hr.group_hr_manager"
        parent="hr_skills_management.menu_skills_view"
        action="action_all_skills"
    />

    <record id="view_hr_employee_skill_kanban" model="ir.ui.view">
        <field name="name">hr.employee.skill</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <kanban
                class="o_kanban_mobile"
                archivable="false"
                js_class="crm_kanban"
                sample="1"
            >
                <field name="employee_id" />
                <field name="skill_id" />
                <field name="skill_level_id" />
                <field name="skill_type_id" />
                <field name="level_progress" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                            <div>
                                <strong class="o_kanban_record_title"><span>
                                    <field name="skill_id" /></span></strong>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <div class="o_kanban_inline_block">
                                        <field name="skill_level_id" />
                                    </div>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                     <field
                                        name="level_progress"
                                        widget="progressbar"
                                    />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hr_employee_skill_view_search" model="ir.ui.view">
        <field name="name">hr.employee.skill.search</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <search string="Skills">
                <field name="skill_type_id" />
                <filter
                    string="Type"
                    name="group_by_skill_type"
                    context="{'group_by': 'skill_type_id'}"
                />
                <filter
                    string="Skill"
                    name="group_by_skill"
                    context="{'group_by': 'skill_id'}"
                />
            </search>
        </field>
    </record>

    <record id="view_hr_employee_skill_tree" model="ir.ui.view">
        <field name="name">hr.employee.skill.tree - all-skills</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <tree>
                <field name="skill_id" string="Skill"/>
                <field name="employee_id" string="Employee"/>
                <field name="skill_level_id" string="Skill Level"/>
                <field name="skill_type_id" string="Type"/>
                <field name="level_progress" string="Level" widget="progressbar"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_employee_skill_pivot" model="ir.ui.view">
        <field name="name">hr.employee.skill.pivot - all-skills</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
<!--            decoration-success="is_even_line=='True'" decoration-warning="is_even_line=='False'"-->
            <pivot string="All Skills" sample="1" >
                <field name="level_progress" type="measure"/>
                <field name="employee_id" type="row"/>
                <field name="skill_type_id" type="col"/>
            </pivot>
        </field>
    </record>

</odoo>
