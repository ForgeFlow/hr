<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="HrOrgChartOverview">
        <div class="o_cp_wrapper d-flex flex-column h-100" t-ref="charDiv">
            <ControlPanel display="controlPanelDisplay">
                <t t-set-slot="control-panel-always-buttons">
                    <button id="print-pdf" class="btn btn-primary o-kanban-button-new">
                        <i class="fa fa-print" /> Print PDF </button>
                    <button id="zoom-in" class="btn btn-primary o-kanban-button-new">
                        <i class="fa fa-plus" />
                    </button>
                    <button
                        type="button"
                        id="toggle-pan"
                        class="btn o-kanban-button-new"
                        accesskey="m"
                    >
                        <i class="fa fa-arrows" title="Toggle Pan" />
                    </button>
                    <button id="zoom-out" class="btn btn-primary o-kanban-button-new">
                        <i class="fa fa-minus" />
                    </button>
                </t>
            </ControlPanel>

            <!-- Chart content area -->
            <div id="chart-container" t-ref="chartContainer" class="flex-grow-1" />
        </div>
    </t>
</templates>
